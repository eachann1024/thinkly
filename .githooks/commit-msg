#!/bin/sh
for ident in "$(git var GIT_AUTHOR_IDENT)" "$(git var GIT_COMMITTER_IDENT)"; do
  case "$ident" in
    *[Cc]laude*|*anthropic.com*)
      echo "✗ 提交身份是 Claude，请先运行 sh .githooks/setup-identity.sh" >&2
      exit 1 ;;
  esac
done
grep -viE '^(co-authored-by:.*(claude|anthropic)|claude-session:)' "$1" | git stripspace > "$1.tmp" && mv "$1.tmp" "$1"
